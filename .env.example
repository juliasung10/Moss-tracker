# Copy to .env.local only if you want to point local development at a hosted
# Postgres. Leave it unset and the app uses PGlite (Postgres in WASM) under data/pg,
# which needs no account and no server.
#
# On Vercel this is injected automatically when you attach a Postgres store —
# you do not set it by hand.
DATABASE_URL=

# Escape hatch: set to 1 only if your provider presents a self-signed certificate.
# PGSSL_NO_VERIFY=
